#!/usr/bin/env bash
# window-arrange — tidy every mapped window on the active workspace.
#
# Hyprland 0.56+ (Omarchy) is Lua-first: `hyprctl dispatch resizewindowpixel …`
# is rejected (dispatch is a shorthand for hl.dispatch). This script applies
# geometry through one `hyprctl eval` of hl.dsp.window.* calls so windows jump
# once to final cells — no focus thrash, no sleeps, no verify/retry loops.
#
# Omarchy-style layout (not fullscreen / not edge-to-edge chrome):
#   - Exit fullscreen / maximized so the top bar + wallpaper stay visible
#   - Integer-split grid with gutters; scrcpy/Pixel → right portrait strip
#   - Strip Omarchy `floating-window*` size/center tags that would fight us
#
# Usage:
#   window-arrange              # apply now
#   window-arrange --dry-run    # print plan only
#   window-arrange --edit       # interactive drag-swap + edge/corner resize
#   window-arrange --on-start   # wait for autostart apps, then arrange once
#
# Env knobs (all optional; unset = adaptive from logical work area):
#   WINDOW_ARRANGE_GAP=12
#   WINDOW_ARRANGE_OUTER=16
#   WINDOW_ARRANGE_PHONE_W=360
#   WINDOW_ARRANGE_PHONE_H=800
#   WINDOW_ARRANGE_ADAPT=1          # 0 = fixed defaults above, still logical geometry
#   WINDOW_ARRANGE_NOTIFY=1         # 0 = silence toast (boot restore)
#   WINDOW_ARRANGE_ON_START_WAIT=8  # seconds --on-start will poll for windows
#   WINDOW_ARRANGE_ON_START_MIN=2   # min mapped windows before arranging
#   WINDOW_ARRANGE_ON_START_STABLE=2  # consecutive stable polls required
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAYOUT_PY=""
for candidate in \
  "${ROOT}/layout.py" \
  "${HOME}/.local/share/window-arrange/layout.py" \
  "${HOME}/.local/bin/layout.py"
do
  if [[ -f $candidate ]]; then
    LAYOUT_PY=$candidate
    break
  fi
done
if [[ -z $LAYOUT_PY ]]; then
  echo "window-arrange: layout.py not found next to script or under ~/.local" >&2
  exit 1
fi

# Companion modules (geometry/apply/editor) live beside layout.py.
LAYOUT_DIR="$(cd "$(dirname "$LAYOUT_PY")" && pwd)"
EDITOR_PY=""
for candidate in \
  "${ROOT}/editor.py" \
  "${LAYOUT_DIR}/editor.py" \
  "${HOME}/.local/share/window-arrange/editor.py" \
  "${HOME}/.local/bin/editor.py"
do
  if [[ -f $candidate ]]; then
    EDITOR_PY=$candidate
    break
  fi
done

GAP=${WINDOW_ARRANGE_GAP:-}
OUTER=${WINDOW_ARRANGE_OUTER:-}
PHONE_W=${WINDOW_ARRANGE_PHONE_W:-}
PHONE_H=${WINDOW_ARRANGE_PHONE_H:-}
DRY=0
ON_START=0
EDIT=0
for arg in "$@"; do
  case "$arg" in
    --dry-run|-n) DRY=1 ;;
    --on-start|--boot|--wait) ON_START=1 ;;
    --edit|--interactive|-e) EDIT=1 ;;
    -h|--help)
      sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
done

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1" >&2; exit 1; }; }
need hyprctl
need python3

# After Hyprland autostart launches apps, wait until a stable set of mapped
# windows is present on the active workspace, then arrange once.
wait_for_autostart_windows() {
  local wait_s min_n stable_need
  wait_s=${WINDOW_ARRANGE_ON_START_WAIT:-8}
  min_n=${WINDOW_ARRANGE_ON_START_MIN:-2}
  stable_need=${WINDOW_ARRANGE_ON_START_STABLE:-2}
  python3 - "$wait_s" "$min_n" "$stable_need" <<'PY'
import json, subprocess, sys, time

wait_s = float(sys.argv[1])
min_n = int(sys.argv[2])
stable_need = int(sys.argv[3])
deadline = time.monotonic() + max(0.5, wait_s)
interval = 0.15
last_key = None
stable = 0
best = 0

def snapshot():
    try:
        active = json.loads(
            subprocess.check_output(["hyprctl", "activeworkspace", "-j"], text=True)
        )
        clients = json.loads(
            subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        )
    except Exception:
        return 0, ""
    ws_id = active.get("id")
    addrs = []
    for c in clients:
        if not c.get("mapped") or c.get("hidden"):
            continue
        ws = c.get("workspace") or {}
        if ws.get("id") != ws_id:
            continue
        if str(ws.get("name", "")).startswith("special"):
            continue
        addr = c.get("address")
        if addr:
            addrs.append(addr)
    addrs.sort()
    return len(addrs), ",".join(addrs)

while time.monotonic() < deadline:
    n, key = snapshot()
    best = max(best, n)
    if n >= min_n and key == last_key and key:
        stable += 1
        if stable >= stable_need:
            print(f"on_start_ready count={n} stable={stable}")
            sys.exit(0)
    else:
        stable = 0
        last_key = key
    time.sleep(interval)

n, _key = snapshot()
print(f"on_start_timeout count={n} best={best}")
# Still proceed: arrange whatever is mapped (may be 0 → no-op).
sys.exit(0)
PY
}

if (( ON_START == 1 )); then
  # Boot path: quiet toast by default unless the user forced NOTIFY=1.
  if [[ -z ${WINDOW_ARRANGE_NOTIFY+x} ]]; then
    export WINDOW_ARRANGE_NOTIFY=0
  fi
  wait_for_autostart_windows
fi

# Interactive editor: drag to rearrange, edge/corner resize with neighbors.
if (( EDIT == 1 )); then
  if [[ -z ${EDITOR_PY} ]]; then
    echo "window-arrange: editor.py not found (install via install.sh)" >&2
    exit 1
  fi
  # Ensure sibling modules import (geometry.py, apply.py, layout.py).
  export PYTHONPATH="${LAYOUT_DIR}:${ROOT}:${PYTHONPATH:-}"
  # gtk4-layer-shell must load before libwayland (see gtk4-layer-shell linking.md).
  for so in \
    /usr/lib/libgtk4-layer-shell.so \
    /usr/lib/libgtk4-layer-shell.so.0 \
    /usr/lib64/libgtk4-layer-shell.so \
    /usr/lib64/libgtk4-layer-shell.so.0
  do
    if [[ -f $so ]]; then
      export LD_PRELOAD="${so}${LD_PRELOAD:+:$LD_PRELOAD}"
      break
    fi
  done
  exec python3 "$EDITOR_PY"
fi

# Snapshot workspace → JSON lines (one object per window).
PLAN=$(
  GAP=$GAP OUTER=$OUTER PHONE_W=$PHONE_W PHONE_H=$PHONE_H \
  WINDOW_ARRANGE_ADAPT=${WINDOW_ARRANGE_ADAPT:-1} \
  python3 "$LAYOUT_PY"
) || true

if [[ -z ${PLAN} ]]; then
  echo "window-arrange: nothing to layout on this workspace" >&2
  exit 0
fi

if (( DRY == 1 )); then
  printf '%s\n' "$PLAN" | python3 -c '
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    o = json.loads(line)
    extra = []
    if o.get("fullscreen") not in (0, False, None):
        extra.append("exit-fs")
    if o.get("pinned"):
        extra.append("unpin")
    tag = (" [" + ", ".join(extra) + "]") if extra else ""
    print(
        "PLAN %s %-12s → %dx%d @ %d,%d%s"
        % (o["role"], o["class"], o["w"], o["h"], o["x"], o["y"], tag)
    )
'
  exit 0
fi

# One hyprctl eval: Lua dispatchers place every window. Live client state is
# read inside the eval so fullscreen/pinned/tags stay accurate.
RESULT=$(
  PLAN=$PLAN \
  python3 - <<'PY'
import json, os, subprocess, sys, time

plan = [json.loads(l) for l in os.environ["PLAN"].splitlines() if l.strip()]
if not plan:
    print("count=0")
    sys.exit(0)

try:
    clients = {
        c["address"]: c
        for c in json.loads(
            subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        )
    }
except Exception as e:
    print(f"error=clients:{e}", file=sys.stderr)
    clients = {}


def lua_str(s: str) -> str:
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


def fs_mode(value) -> int:
    try:
        return int(value)
    except Exception:
        return 1 if value else 0


# Build a single Lua chunk. Hyprland 0.56 notes:
#   - fullscreen mode=false exits; mode=0 toggles into maximized
#   - float({on=true}) is idempotent (toggle would thrash already-floating)
#   - Omarchy tags floating-window* attach size={875,600}/center rules; strip
#     them before resize/move so the planned cell sticks
#   - apply geometry twice: first float can re-trigger window rules; second
#     pass locks the planned cell without sleeps
lines: list[str] = [
    # Hyprland 0.56 notes (verified on Omarchy):
    #   - fullscreen({mode=false}) toggles when already off → only if need_fs
    #   - maximized (fs=1) needs two mode=false calls (1→2→0)
    #   - window.float always toggles (on/floating/action args ignored) → only
    #     if the live client is tiled
    #   - strip Omarchy floating-window*/pop tags so size/center rules don't fight
    "local function apply(w, x, y, rw, rh, need_fs, need_float, need_pin)",
    "  pcall(function() hl.dispatch(hl.dsp.window.tag({ window = w, tag = '-floating-window*' })) end)",
    "  pcall(function() hl.dispatch(hl.dsp.window.tag({ window = w, tag = '-floating-window' })) end)",
    "  pcall(function() hl.dispatch(hl.dsp.window.tag({ window = w, tag = '-pop' })) end)",
    "  pcall(function() hl.dispatch(hl.dsp.window.tag({ window = w, tag = '-pop*' })) end)",
    "  if need_fs then",
    "    hl.dispatch(hl.dsp.window.fullscreen({ window = w, mode = false }))",
    "    hl.dispatch(hl.dsp.window.fullscreen({ window = w, mode = false }))",
    "  end",
    "  if need_pin then",
    "    pcall(function() hl.dispatch(hl.dsp.window.pin({ window = w })) end)",
    "  end",
    "  if need_float then",
    "    hl.dispatch(hl.dsp.window.float({ window = w }))",
    "  end",
    "  hl.dispatch(hl.dsp.window.resize({ window = w, x = rw, y = rh }))",
    "  hl.dispatch(hl.dsp.window.move({ window = w, x = x, y = y }))",
    # Second geometry pass: rules can reflow once after the first float.
    "  hl.dispatch(hl.dsp.window.resize({ window = w, x = rw, y = rh }))",
    "  hl.dispatch(hl.dsp.window.move({ window = w, x = x, y = y }))",
    "end",
]

for p in plan:
    addr = p["address"]
    live = clients.get(addr, {})
    fs_i = fs_mode(live.get("fullscreen", p.get("fullscreen") or 0))
    floating = bool(live.get("floating", p.get("floating")))
    pinned = bool(live.get("pinned", p.get("pinned")))
    # Omarchy "pop" tag means pinned float; pin dispatcher toggles off.
    tags = live.get("tags") or []
    if any(str(t).rstrip("*") == "pop" for t in tags):
        pinned = True
    # window.float toggles. Only call it when currently tiled. Exiting a
    # tiled maximize leaves the window tiled (need float); exiting a floating
    # maximize leaves it floating (skip float or we toggle back to tiled).
    need_float = not floating
    lines.append(
        "apply(%s, %d, %d, %d, %d, %s, %s, %s)"
        % (
            lua_str(f"address:{addr}"),
            int(p["x"]),
            int(p["y"]),
            int(p["w"]),
            int(p["h"]),
            "true" if fs_i else "false",
            "true" if need_float else "false",
            "true" if pinned else "false",
        )
    )

lines.append(f'print("arranged={len(plan)}")')
lua = "\n".join(lines)

t0 = time.monotonic()
proc = subprocess.run(
    ["hyprctl", "eval", lua],
    text=True,
    capture_output=True,
)
dt = (time.monotonic() - t0) * 1000

for p in plan:
    print(
        f"OK {p['role']} {p.get('class', ''):<12} → {p['w']}x{p['h']} @ {p['x']},{p['y']}"
    )

print(f"count={len(plan)}")
print(f"ms={dt:.0f}")
print(f"eval_rc={proc.returncode}")
# hyprctl eval prints "ok" on success; keep stderr noise small.
err = (proc.stderr or "").strip()
if proc.returncode != 0 and err:
    print(f"eval_err={err[:300]}", file=sys.stderr)
elif "error:" in (proc.stdout or "").lower():
    # Some builds put Lua errors on stdout.
    print(f"eval_out={(proc.stdout or '').strip()[:300]}", file=sys.stderr)
PY
) || true

printf '%s\n' "$RESULT"

count=$(printf '%s\n' "$RESULT" | sed -n 's/^count=//p' | tail -1)
count=${count:-0}

if (( count > 0 )) && [[ ${WINDOW_ARRANGE_NOTIFY:-1} != 0 ]]; then
  # -g must be a single Nerd Font glyph — never a word (words render as junk).
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send \
      --app-name window-arrange \
      -g "󰕰" \
      -t 1800 \
      "Arranged $count windows" \
      "Instant grid" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a window-arrange -t 1800 "Arranged $count windows" "Instant grid" 2>/dev/null || true
  fi
fi

exit 0
