#!/usr/bin/env bash
# window-arrange — tidy every mapped window on the active workspace.
#
# Fast path (no thrash):
#   1. One layout plan (layout.py, logical pixels / HiDPI-aware)
#   2. One hyprctl clients snapshot
#   3. One hyprctl --batch of address-targeted dispatches
#   → windows jump once to final cells. No focus cycling, no sleeps,
#     no verify/retry loops (those were the multi-second lag with 5+ windows).
#
# Omarchy-style layout (not fullscreen / not edge-to-edge chrome):
#   - Exit fullscreen / maximized so the top bar + wallpaper stay visible
#   - Integer-split grid with gutters; scrcpy/Pixel → right portrait strip
#
# Usage:
#   window-arrange           # apply
#   window-arrange --dry-run # print plan only
#
# Env knobs (all optional; unset = adaptive from logical work area):
#   WINDOW_ARRANGE_GAP=12
#   WINDOW_ARRANGE_OUTER=16
#   WINDOW_ARRANGE_PHONE_W=360
#   WINDOW_ARRANGE_PHONE_H=800
#   WINDOW_ARRANGE_ADAPT=1       # 0 = fixed defaults above, still logical geometry
#   WINDOW_ARRANGE_NOTIFY=1      # 0 = silence toast (boot restore)
#   WINDOW_ARRANGE_ANIM=0        # 1 = leave animations on (default off for instant place)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAYOUT_PY=""
for candidate in \
  "${ROOT}/layout.py" \
  "${HOME}/.local/share/window-arrange/layout.py" \
  "${HOME}/.local/bin/layout.py"
do
  if [[ -f $candidate ]]; then
    LAYOUT_PY=$candidate
    break
  fi
done
if [[ -z $LAYOUT_PY ]]; then
  echo "window-arrange: layout.py not found next to script or under ~/.local" >&2
  exit 1
fi

GAP=${WINDOW_ARRANGE_GAP:-}
OUTER=${WINDOW_ARRANGE_OUTER:-}
PHONE_W=${WINDOW_ARRANGE_PHONE_W:-}
PHONE_H=${WINDOW_ARRANGE_PHONE_H:-}
DRY=0
[[ ${1:-} == "--dry-run" || ${1:-} == "-n" ]] && DRY=1

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1" >&2; exit 1; }; }
need hyprctl
need python3

# Snapshot workspace → JSON lines (one object per window).
PLAN=$(
  GAP=$GAP OUTER=$OUTER PHONE_W=$PHONE_W PHONE_H=$PHONE_H \
  WINDOW_ARRANGE_ADAPT=${WINDOW_ARRANGE_ADAPT:-1} \
  python3 "$LAYOUT_PY"
) || true

if [[ -z ${PLAN} ]]; then
  echo "window-arrange: nothing to layout on this workspace" >&2
  exit 0
fi

if (( DRY == 1 )); then
  printf '%s\n' "$PLAN" | python3 -c '
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    o = json.loads(line)
    extra = []
    if o.get("fullscreen") not in (0, False, None):
        extra.append("exit-fs")
    if o.get("pinned"):
        extra.append("unpin")
    tag = (" [" + ", ".join(extra) + "]") if extra else ""
    print(
        "PLAN %s %-12s → %dx%d @ %d,%d%s"
        % (o["role"], o["class"], o["w"], o["h"], o["x"], o["y"], tag)
    )
'
  exit 0
fi

# Build + fire a single batch. All geometry is address-targeted so we never
# focus-cycle (focus thrash is what looked like "random movement").
RESULT=$(
  PLAN=$PLAN \
  WINDOW_ARRANGE_ANIM=${WINDOW_ARRANGE_ANIM:-0} \
  python3 - <<'PY'
import json, os, subprocess, sys, time

plan = [json.loads(l) for l in os.environ["PLAN"].splitlines() if l.strip()]
if not plan:
    print("count=0")
    sys.exit(0)

# One clients snapshot for floating/fullscreen/pinned state.
try:
    clients = {
        c["address"]: c
        for c in json.loads(
            subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        )
    }
except Exception as e:
    print(f"error=clients:{e}", file=sys.stderr)
    clients = {}

anim_off = os.environ.get("WINDOW_ARRANGE_ANIM", "0") != "1"
batch: list[str] = []

def add(cmd: str) -> None:
    batch.append(cmd)

if anim_off:
    # Instant place; restored at end of batch.
    add("keyword animation windows,0")
    add("keyword animation layers,0")
    add("keyword animation fade,0")
    add("keyword animation border,0")

for p in plan:
    addr = p["address"]
    win = f"address:{addr}"
    live = clients.get(addr, {})
    fs = live.get("fullscreen", p.get("fullscreen") or 0)
    try:
        fs_i = int(fs)
    except Exception:
        fs_i = 1 if fs else 0
    floating = bool(live.get("floating", p.get("floating")))
    pinned = bool(live.get("pinned", p.get("pinned")))

    # Fullscreen off without focusing (state dispatch is global-on-active on
    # some builds, so prefer window-scoped Lua form first; batch both).
    if fs_i:
        add(f"dispatch fullscreenstate 0 0 {win}")
        # Fallback used by older parsers that ignore the address suffix:
        add(f"dispatch focuswindow {win}")
        add("dispatch fullscreenstate 0 0")

    if pinned:
        add(f"dispatch pin {win}")

    if not floating:
        add(f"dispatch togglefloating {win}")

    # Address-targeted geometry — NO focuswindow before move/resize.
    # resizewindowpixel / movewindowpixel take "exact W H,address:0x…"
    w, h, x, y = int(p["w"]), int(p["h"]), int(p["x"]), int(p["y"])
    add(f"dispatch resizewindowpixel exact {w} {h},{win}")
    add(f"dispatch movewindowpixel exact {x} {y},{win}")

    # Drop pop tag if present (ignore failures inside batch).
    add(f"dispatch tagwindow -pop {win}")

if anim_off:
    add("keyword animation windows,1")
    add("keyword animation layers,1")
    add("keyword animation fade,1")
    add("keyword animation border,1")

batch_body = " ; ".join(batch)
t0 = time.monotonic()
# hyprctl --batch runs the chain in one IPC round-trip.
proc = subprocess.run(
    ["hyprctl", "--batch", batch_body],
    text=True,
    capture_output=True,
)
dt = (time.monotonic() - t0) * 1000

# Print per-window summary from the plan (final targets, not live thrash).
for p in plan:
    print(
        f"OK {p['role']} {p.get('class', ''):<12} → {p['w']}x{p['h']} @ {p['x']},{p['y']}"
    )

print(f"count={len(plan)}")
print(f"ms={dt:.0f}")
print(f"batch_rc={proc.returncode}")
if proc.returncode != 0 and proc.stderr.strip():
    # Non-fatal: some tag/anim keywords may 404 on minimal builds.
    err = proc.stderr.strip().replace("\n", " | ")
    print(f"batch_err={err[:300]}", file=sys.stderr)
PY
) || true

printf '%s\n' "$RESULT"

count=$(printf '%s\n' "$RESULT" | sed -n 's/^count=//p' | tail -1)
count=${count:-0}

if (( count > 0 )) && [[ ${WINDOW_ARRANGE_NOTIFY:-1} != 0 ]]; then
  # -g must be a single Nerd Font glyph — never a word (words render as junk).
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send \
      --app-name window-arrange \
      -g "󰕰" \
      -t 1800 \
      "Arranged $count windows" \
      "Instant grid" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a window-arrange -t 1800 "Arranged $count windows" "Instant grid" 2>/dev/null || true
  fi
fi

exit 0
