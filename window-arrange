#!/usr/bin/env bash
# window-arrange — tidy every mapped window on the active workspace.
#
# Omarchy-style layout (not fullscreen / not edge-to-edge chrome):
#   - Exit fullscreen / maximized on every window (bar + wallpaper stay visible)
#   - Plan geometry in *logical* pixels (physical / monitor scale) so HiDPI
#     and scale-1.0 machines share the same visual density
#   - Non-phone apps → even floating grid with outer padding
#   - scrcpy / Pixel → compact floating portrait strip on the right
#
# Usage:
#   window-arrange           # apply
#   window-arrange --dry-run # print plan only
#
# Env knobs (all optional; unset = adaptive from logical work area):
#   WINDOW_ARRANGE_GAP=8
#   WINDOW_ARRANGE_OUTER=12
#   WINDOW_ARRANGE_PHONE_W=360
#   WINDOW_ARRANGE_PHONE_H=800
#   WINDOW_ARRANGE_ADAPT=1    # 0 = fixed defaults above, still logical geometry
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Prefer alongside the script (repo / install copy next to layout.py).
LAYOUT_PY=""
for candidate in \
  "${ROOT}/layout.py" \
  "${HOME}/.local/share/window-arrange/layout.py" \
  "${HOME}/.local/bin/layout.py"
do
  if [ -f "$candidate" ]; then
    LAYOUT_PY="$candidate"
    break
  fi
done
if [ -z "$LAYOUT_PY" ]; then
  echo "window-arrange: layout.py not found next to script or under ~/.local" >&2
  exit 1
fi

GAP="${WINDOW_ARRANGE_GAP:-}"
OUTER="${WINDOW_ARRANGE_OUTER:-}"
PHONE_W="${WINDOW_ARRANGE_PHONE_W:-}"
PHONE_H="${WINDOW_ARRANGE_PHONE_H:-}"
DRY=0
[[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]] && DRY=1

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1" >&2; exit 1; }; }
need hyprctl
need python3

dispatch() {
  local lua="$1"
  shift
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  hyprctl dispatch "$lua" >/dev/null 2>&1 || {
    [ "$#" -gt 0 ] && hyprctl dispatch "$@" >/dev/null 2>&1 || true
  }
}

# Snapshot workspace → JSON plan (one object per line), logical coordinates.
PLAN="$(
  GAP="$GAP" OUTER="$OUTER" PHONE_W="$PHONE_W" PHONE_H="$PHONE_H" \
  WINDOW_ARRANGE_ADAPT="${WINDOW_ARRANGE_ADAPT:-1}" \
  python3 "$LAYOUT_PY"
)" || true

if [ -z "${PLAN}" ]; then
  echo "window-arrange: nothing to layout on this workspace" >&2
  exit 0
fi

apply_one() {
  local addr="$1" cls="$2" role="$3" mode="$4"
  local x="$5" y="$6" w="$7" h="$8"
  local was_fs="$9" was_floating="${10}" was_pinned="${11}"
  local window="address:${addr}"

  if [ "$DRY" -eq 1 ]; then
    printf 'PLAN %s %-12s %s → %dx%d @ %d,%d%s%s\n' \
      "$role" "$cls" "$mode" "$w" "$h" "$x" "$y" \
      "$([ "$was_fs" = "True" ] || [ "$was_fs" = "true" ] && echo ' [exit-fullscreen]' || true)" \
      "$([ "$was_pinned" = "True" ] || [ "$was_pinned" = "true" ] && echo ' [unpin]' || true)"
    return 0
  fi

  # 1) Always leave fullscreen / maximized so the Omarchy bar + wallpaper show.
  if [ "$was_fs" = "True" ] || [ "$was_fs" = "true" ] || [ "$was_fs" = "1" ] || [ "$was_fs" = "2" ]; then
    dispatch "hl.dsp.focus({ window = \"$window\" })" focuswindow "$window"
    dispatch "hl.dsp.window.fullscreen({ mode = \"0\" })" fullscreen 0
    hyprctl dispatch fullscreenstate 0 0 >/dev/null 2>&1 || true
    sleep 0.05
  fi

  # 2) Unpin pop-outs so they can move/resize.
  if [ "$was_pinned" = "True" ] || [ "$was_pinned" = "true" ]; then
    dispatch "hl.dsp.window.pin({ window = \"$window\" })" pin "$window"
  fi

  # 3) Ensure floating for placed layout (even cells with padding).
  if [ "$was_floating" != "True" ] && [ "$was_floating" != "true" ]; then
    dispatch "hl.dsp.window.float({ window = \"$window\", action = \"toggle\" })" \
      togglefloating "$window"
  fi

  dispatch "hl.dsp.focus({ window = \"$window\" })" focuswindow "$window"
  dispatch "hl.dsp.window.resize({ window = \"$window\", x = $w, y = $h })" \
    resizeactive exact "$w" "$h"
  dispatch "hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })" \
    moveactive exact "$x" "$y"

  hyprctl dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"-pop\" })" >/dev/null 2>&1 || true

  sleep 0.04
  # Verify + one retry
  local got gx gy gw gh
  got="$(hyprctl clients -j | python3 -c "
import json,sys
a='$addr'
for c in json.load(sys.stdin):
  if c.get('address')==a:
    print(c['at'][0], c['at'][1], c['size'][0], c['size'][1], int(bool(c.get('fullscreen'))))
    break
" 2>/dev/null || true)"
  read -r gx gy gw gh gfs <<<"${got:-0 0 0 0 0}"
  if [ "${gfs:-0}" != "0" ]; then
    dispatch "hl.dsp.focus({ window = \"$window\" })"
    dispatch "hl.dsp.window.fullscreen({ mode = \"0\" })" fullscreen 0
    hyprctl dispatch fullscreenstate 0 0 >/dev/null 2>&1 || true
  fi
  if [ -n "${gx:-}" ] && { [ "$gx" != "0" ] || [ "${gy:-0}" != "0" ]; }; then
    if [ $((gx < x - 20 || gx > x + 20 || gy < y - 20 || gy > y + 20 || gw < w - 20 || gw > w + 20 || gh < h - 20 || gh > h + 20)) -eq 1 ]; then
      dispatch "hl.dsp.window.resize({ window = \"$window\", x = $w, y = $h })"
      dispatch "hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })"
    fi
  fi

  printf 'OK %s %-12s → %dx%d @ %d,%d\n' "$role" "$cls" "$w" "$h" "$x" "$y"
}

count=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  eval "$(printf '%s' "$line" | python3 -c '
import json,sys,shlex
o=json.load(sys.stdin)
def q(s): return shlex.quote(str(s))
print("addr=%s cls=%s role=%s mode=%s x=%s y=%s w=%s h=%s was_fs=%s was_floating=%s was_pinned=%s" % (
  q(o["address"]), q(o["class"]), q(o["role"]), q(o["mode"]),
  q(o["x"]), q(o["y"]), q(o["w"]), q(o["h"]),
  q(o.get("fullscreen", False)), q(o.get("floating", False)), q(o.get("pinned", False)),
))
')"
  apply_one "$addr" "$cls" "$role" "$mode" "$x" "$y" "$w" "$h" "$was_fs" "$was_floating" "$was_pinned"
  count=$((count + 1))
done <<< "$PLAN"

if [ "$DRY" -eq 0 ] && [ "$count" -gt 0 ]; then
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g "Arranged" "Arranged $count windows" "Padded grid · bar & wallpaper visible" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a window-arrange "Arranged $count windows" 2>/dev/null || true
  fi
fi

exit 0
